PERSEUS_ENABLED=1

PERSEUS_ACTOR_PROVIDER=openai-compatible
PERSEUS_ACTOR_MODEL=
PERSEUS_ACTOR_BASE_URL=
PERSEUS_ACTOR_API_TYPE=openai-completions
PERSEUS_ACTOR_API_KEY=
PERSEUS_ACTOR_USER_AGENT=Perseus/0.1
PERSEUS_ACTOR_THINKING=high

# For Anthropic-compatible gateways, set both roles to anthropic-messages.
# PERSEUS_ACTOR_API_TYPE=anthropic-messages

# Defaults to the Actor endpoint. Override all fields for role separation.
PERSEUS_SPECULATOR_PROVIDER=openai-compatible
PERSEUS_SPECULATOR_MODEL=
PERSEUS_SPECULATOR_BASE_URL=
PERSEUS_SPECULATOR_API_TYPE=openai-completions
PERSEUS_SPECULATOR_API_KEY=
PERSEUS_SPECULATOR_USER_AGENT=Perseus/0.1
PERSEUS_SPECULATOR_THINKING=off

PERSEUS_TOP_K=3
PERSEUS_SAFE_TOOLS=read,grep,find,ls
PERSEUS_SPECULATOR_MAX_TOKENS=
PERSEUS_SPECULATOR_TIMEOUT_MS=
PERSEUS_SPECULATOR_MIN_CONFIDENCE=0.5
PERSEUS_SPECULATOR_MAX_MISS_TURNS=4
PERSEUS_SPECULATOR_COOLDOWN_TURNS=4
PERSEUS_TRACE_FILE=/tmp/perseus-trace.jsonl

PERSEUS_API_TIMEOUT_MS=180000
PERSEUS_API_MAX_RETRIES=1
PERSEUS_API_MAX_RETRY_DELAY_MS=30000
PERSEUS_CONTEXT_WINDOW=128000
